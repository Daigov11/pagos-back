PORT=4001
NODE_ENV=development

# Frontend URL permitido para CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173

# API externa (Centralizador)
EXTERNAL_API_BASE_URL=https://api-centralizador.apiworking.pe/api

# Secreto para firmar nuestro propio JWT (cookie de sesion).
# Generar uno fuerte en produccion, ej: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Nombre de la cookie de sesion
SESSION_COOKIE_NAME=vendedores_session

# Token de respaldo (rol _SISTEMAS) para consultar orden-servicio cuando el usuario
# logueado no tiene permiso (403) para ese endpoint. Es temporal y expira, hay que
# renovarlo periodicamente generando uno nuevo con un usuario de rol _SISTEMAS.
EXTERNAL_API_FALLBACK_TOKEN=

# MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=vendedores_app

# Almacen por defecto para traer el catalogo de equipos/productos del cotizador
ALMACEN_ID_DEFAULT=8

# API de consulta DNI/RUC (apilatam.com) para verificar datos del cliente en cotizaciones
DOCUMENTOS_API_BASE_URL=https://apilatam.com/api
DOCUMENTOS_API_TOKEN=

# Chat IA (Claude / Anthropic) para el cotizador. Roles autorizados a usarlo.
CHATIA_API_KEY=
CHATIA_MODEL=claude-opus-5
CHATIA_ROLES=_SISTEMAS,ADMINISTRADOR,POSTVENTA
